"""Port numbers for the Boost Move Hub."""

A: int = 0x00
"""External port A / built-in motor A."""
B: int = 0x01
"""External port B / built-in motor B."""
AB: int = 0x10
"""Virtual A+B synchronised motor pair."""
C: int = 0x02
"""External port C."""
D: int = 0x03
"""External port D."""
LED: int = 0x32
"""Built-in hub LED."""
TILT: int = 0x3A
"""Built-in tilt sensor."""
CURRENT: int = 0x3B
"""Built-in current sensor."""
VOLTAGE: int = 0x3C
"""Built-in voltage sensor."""

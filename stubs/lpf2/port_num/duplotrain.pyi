"""Port numbers for the Duplo Train base hub."""

MOTOR: int = 0x00
"""Built-in train motor."""
LED: int = 0x11
"""Built-in hub LED."""
SPEAKER: int = 0x01
"""Built-in speaker."""
COLOR: int = 0x12
"""Built-in colour sensor."""
SPEEDOMETER: int = 0x13
"""Built-in speedometer."""
VOLTAGE: int = 0x14
"""Built-in voltage sensor."""

"""Port numbers for the Technic Control+ hub."""

A: int = 0x00
"""External port A."""
B: int = 0x01
"""External port B."""
C: int = 0x02
"""External port C."""
D: int = 0x03
"""External port D."""
LED: int = 0x32
"""Built-in hub RGB LED."""
CURRENT: int = 0x3B
"""Built-in current sensor."""
VOLTAGE: int = 0x3C
"""Built-in voltage sensor."""
TEMP: int = 0x3D
"""Built-in primary temperature sensor."""
TEMP2: int = 0x60
"""Built-in secondary temperature sensor."""
ACCELEROMETER: int = 0x61
"""Built-in accelerometer."""
GYRO: int = 0x62
"""Built-in gyroscope."""
TILT: int = 0x63
"""Built-in tilt sensor."""
GESTURE: int = 0x64
"""Built-in gesture sensor."""
